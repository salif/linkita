{
  "name": "linkita",
  "version": "3.2025_04_22",
  "description": "A clean and elegant blog theme for Zola. Linkita is based on Kita and Hugo-Paper and is multilingual and SEO friendly.",
  "homepage": "https://codeberg.org/salif/linkita",
  "license": "MIT",
  "author": {
    "name": "Salif Mehmed",
    "email": "mail@salif.eu",
    "url": "https://salif.eu"
  },
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/salif/linkita.git"
  },
  "scripts": {
    "dev:css": "pnpm tailwindcss -i ./static/app.css -o ./static/main.min.css --minify --watch",
    "build:css": "pnpm tailwindcss -i ./static/app.css -o ./static/main.min.css --minify",
    "build:nomincss": "pnpm tailwindcss -i ./static/app.css -o ./static/main.css",
    "build:linkitaJS": "pnpm terser ./static/js/linkita.js -o ./static/js/linkita.min.js",
    "build:searchJS": "pnpm terser ./static/js/linkita-search.js -o ./static/js/linkita-search.min.js",
    "build:gcJS": "pnpm terser ./static/js/gc.js -o ./static/js/gc.min.js"
  },
  "devDependencies": {
    "@iarna/toml": "^2.2.5",
    "@tailwindcss/cli": "^4.1.14",
    "@tailwindcss/typography": "^0.5.19",
    "execa": "^9.6.0",
    "instant.page": "^5.2.0",
    "katex": "^0.16.22",
    "simple-icons": "^14.15.0",
    "tailwindcss": "^4.1.14",
    "terser": "^5.44.0"
  }
}
