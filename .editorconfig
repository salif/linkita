# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true

[{justfile,*.just}]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.md]
indent_style = space
indent_size = 4
trim_trailing_whitespace = false
max_line_length = 80

[*.{html,css,js,json,xml}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.toml,yaml]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[{LICENSE*,LICENCE*,*.min.js,*.min.css,public/*}]
indent_style = unset
indent_size = unset
insert_final_newline = unset
